rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Proteger los datos de cada usuario autenticado
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      // Permitir acceso a la subcolección de tareas del usuario
      match /tareas/{tareaId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      
      // Permitir acceso a la subcolección de hábitos del usuario
      match /habitos/{habitoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
