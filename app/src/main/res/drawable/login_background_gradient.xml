<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#5039FF14"
                android:centerColor="#1939FF14"
                android:endColor="#000A0A0A"
                android:centerY="0.35" />
        </shape>
    </item>

</layer-list>
