<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/habito_card_background">

    <!-- Fila principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Icono del hábito -->
        <TextView
            android:id="@+id/tvIconoHabito"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="●"
            android:textSize="22sp"
            android:background="@drawable/habito_icon_background" />

        <!-- Nombre y progreso -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreHabito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del hábito"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0 días completados"
                android:textColor="#8C8C8C"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- Marcar completado -->
        <CheckBox
            android:id="@+id/checkHabitoHoy"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:buttonTint="#39FF14"
            android:contentDescription="Marcar hábito como completado"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Barra de progreso -->
    <ProgressBar
        android:id="@+id/progresoHabito"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="12dp"
        android:max="31"
        android:progress="0"
        android:progressTint="#39FF14"
        android:progressBackgroundTint="#2A2A2A" />

    <!-- Racha -->
    <TextView
        android:id="@+id/tvRacha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:text="🔥 Racha actual: 0 días"
        android:textColor="#B8B8B8"
        android:textSize="12sp" />

    <!-- Se conserva este contenedor porque el adaptador actual lo utiliza.
         En el siguiente paso lo conectaremos con la selección semanal. -->
    <GridLayout
        android:id="@+id/gridDias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:columnCount="7"
        android:visibility="gone" />

</LinearLayout>
