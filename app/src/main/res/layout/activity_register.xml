<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- ENCABEZADO -->

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:background="@drawable/login_secondary_button"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TASK"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FLOW"
                android:textColor="#39FF14"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

        </LinearLayout>

        <!-- TITULO -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Creá tu cuenta"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Empezá a organizar tus tareas y construir hábitos."
            android:textColor="#8C8C8C"
            android:textSize="14sp" />

        <!-- NOMBRE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Nombre completo"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/login_input_background"
            android:hint="Tu nombre y apellido"
            android:inputType="textPersonName|textCapWords"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- EMAIL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Email"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/login_input_background"
            android:hint="tu@email.com"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- CONTRASEÑA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Contraseña"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/login_input_background"
            android:hint="Creá una contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- INDICADOR VISUAL DE SEGURIDAD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_weight="1"
                android:background="#39FF14" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#39FF14" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#39FF14" />

            <View
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="#333333" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Seguridad: Fuerte"
            android:textColor="#39FF14"
            android:textSize="12sp" />

        <!-- CONFIRMAR CONTRASEÑA -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Confirmar contraseña"
            android:textColor="#A0A0A0"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/login_input_background"
            android:hint="Repetí tu contraseña"
            android:inputType="textPassword"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:textSize="15sp"
            android:singleLine="true" />

        <!-- TERMINOS -->

        <CheckBox
            android:id="@+id/cbTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:buttonTint="#39FF14"
            android:text="Acepto los Términos y la Política de privacidad"
            android:textColor="#A0A0A0"
            android:textSize="12sp" />

        <!-- CREAR CUENTA -->

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/login_button_background"
            android:elevation="8dp"
            android:stateListAnimator="@null"
            android:text="Crear cuenta  ›"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- VOLVER AL LOGIN -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="¿Ya tenés cuenta? Iniciá sesión"
            android:textColor="#39FF14"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
