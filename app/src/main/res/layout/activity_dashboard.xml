package com.example.taskflow

    import android.content.Intent
    import android.os.Bundle
    import android.widget.TextView
    import android.widget.Toast
    import androidx.appcompat.app.AppCompatActivity
    import com.google.android.material.bottomnavigation.BottomNavigationView
    import com.google.firebase.auth.FirebaseAuth
    import com.google.firebase.firestore.FirebaseFirestore

    class DashboardActivity : AppCompatActivity() {

    private lateinit var auth: FirebaseAuth
    private lateinit var db: FirebaseFirestore

    private lateinit var tvPending: TextView
    private lateinit var tvProgress: TextView
    private lateinit var tvCompleted: TextView

    override fun onCreate(savedInstanceState: Bundle?) {
    super.onCreate(savedInstanceState)

    setContentView(R.layout.activity_dashboard)

    auth = FirebaseAuth.getInstance()
    db = FirebaseFirestore.getInstance()

    val tvWelcome = findViewById<TextView>(R.id.tvWelcome)
    tvPending = findViewById(R.id.tvPending)
    tvProgress = findViewById(R.id.tvProgress)
    tvCompleted = findViewById(R.id.tvCompleted)

    val bottomNavigation =
    findViewById<BottomNavigationView>(R.id.bottomNavigation)

        val usuario = auth.currentUser

        if (usuario != null) {
        tvWelcome.text = "Hola 👋\n${usuario.email}"

        cargarContadores(usuario.uid)
        } else {
        Toast.makeText(
        this,
        "No hay ningún usuario iniciado",
        Toast.LENGTH_SHORT
        ).show()
        }

        bottomNavigation.selectedItemId = R.id.nav_home

        bottomNavigation.setOnItemSelectedListener { item ->

        when (item.itemId) {

        R.id.nav_home -> {
        true
        }

        R.id.nav_kanban -> {
        startActivity(
        Intent(this, KanbanActivity::class.java)
        )
        true
        }

        R.id.nav_create -> {
        startActivity(
        Intent(this, CreateTaskActivity::class.java)
        )
        true
        }

        R.id.nav_habitos -> {
        startActivity(
        Intent(this, HabitosActivity::class.java)
        )
        true
        }

        R.id.nav_profile -> {
        startActivity(
        Intent(this, ProfileActivity::class.java)
        )
        true
        }

        else -> false
        }
        }
        }

        override fun onResume() {
        super.onResume()

        val usuario = auth.currentUser

        if (usuario != null) {
        cargarContadores(usuario.uid)
        }
        }

        private fun cargarContadores(uid: String) {

        db.collection("usuarios")
        .document(uid)
        .collection("tareas")
        .get()
        .addOnSuccessListener { documentos ->

        var pendientes = 0
        var enProgreso = 0
        var completadas = 0

        for (documento in documentos) {

        val status =
        documento.getString("status") ?: "Pendiente"

        when (status) {

        "Pendiente" -> {
        pendientes++
        }

        "En progreso" -> {
        enProgreso++
        }

        "Completado" -> {
        completadas++
        }
        }
        }

        tvPending.text =
        "Pendientes\n$pendientes"

        tvProgress.text =
        "En progreso\n$enProgreso"

        tvCompleted.text =
        "Completadas\n$completadas"
        }
        .addOnFailureListener { error ->

        Toast.makeText(
        this,
        "Error al cargar las tareas: ${error.message}",
        Toast.LENGTH_LONG
        ).show()
        }
        }
        }